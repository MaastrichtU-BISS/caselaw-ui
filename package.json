{
  "name": "caselaw-ui",
  "version": "0.9.26",
  "description": "Shared Case Law Explorer design tokens and Vue/Svelte UI primitives.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaastrichtU-BISS/caselaw-ui.git"
  },
  "homepage": "https://github.com/MaastrichtU-BISS/caselaw-ui#readme",
  "bugs": {
    "url": "https://github.com/MaastrichtU-BISS/caselaw-ui/issues"
  },
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "src",
    "README.md",
    "docs",
    "scripts",
    "tests"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles/index.css",
    "./tokens": {
      "types": "./src/tokens.ts",
      "default": "./src/tokens.ts"
    },
    "./svelte": {
      "types": "./src/svelte/index.ts",
      "default": "./src/svelte/index.ts"
    },
    "./vue": {
      "types": "./src/vue/index.ts",
      "default": "./src/vue/index.ts"
    }
  },
  "scripts": {
    "check": "npm run check:vue && npm run check:svelte && npm test",
    "pack:dry": "npm pack --dry-run",
    "check:svelte": "node scripts/compile-svelte.mjs",
    "check:vue": "vue-tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "svelte": "^5.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.8"
  }
}
