{
  "name": "biss-ui",
  "version": "0.1.0-next.0",
  "description": "Customizable Vue and Svelte components with the Bizzy design language.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaastrichtU-BISS/caselaw-ui.git"
  },
  "homepage": "https://bissui.wicker.life",
  "bugs": {
    "url": "https://github.com/MaastrichtU-BISS/caselaw-ui/issues"
  },
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "DESIGN.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./styles.css": "./dist/styles/index.css",
    "./styles/*": "./dist/styles/*",
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "import": "./dist/svelte/index.js"
    },
    "./package.json": "./package.json",
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    }
  },
  "scripts": {
    "check": "npm run tokens:check && npm run check:vue && npm run check:svelte && npm test",
    "pack:dry": "npm pack --dry-run",
    "check:svelte": "node scripts/compile-svelte.mjs && npm run check:svelte:types",
    "check:vue": "vue-tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "demo": "vite --host 127.0.0.1",
    "demo:build": "vite build && vite build --config vite.svelte.config.ts",
    "test:browser": "node scripts/test-browser.mjs && SVELTE=1 node scripts/test-browser.mjs",
    "check:svelte:types": "svelte-check --tsconfig ./tsconfig.svelte.json",
    "docs:generate": "node scripts/generate-docs.mjs && node scripts/docs-api.mjs",
    "docs:dev": "vite --config vite.docs.config.ts --host 127.0.0.1",
    "docs:build": "npm run docs:generate && vite build --config vite.docs.config.ts",
    "docs:screenshots": "tsx scripts/capture-docs.ts",
    "docs:check": "tsx scripts/check-docs.ts",
    "docs:markdown": "node scripts/docs-markdown.mjs",
    "docs:typecheck": "vue-tsc --noEmit -p tsconfig.docs.json && svelte-check --tsconfig ./tsconfig.docs-svelte.json --fail-on-warnings",
    "tokens:generate": "node scripts/generate-tokens.mjs",
    "tokens:check": "node scripts/generate-tokens.mjs --check",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test:package": "tsx scripts/test-package.ts"
  },
  "peerDependencies": {
    "svelte": "^5.20.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.65.0",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "prettier": "^3.10.0",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.7.8",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "vite": "^8.3.8",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.8"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
