{
  "compilerOptions": {
    "allowArbitraryExtensions": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "types": [
      "svelte"
    ],
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "src/**/*.svelte",
    "src/**/*.d.ts"
  ]
}
